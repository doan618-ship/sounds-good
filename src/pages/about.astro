---
import BaseLayout from '../layouts/BaseLayout.astro';

const spectrumAxes = [
  {
    icon: 'bi-music-note-beamed',
    title: 'Giai điệu',
    description: 'Đánh giá tính bắt tai, hòa âm, cao độ giọng hát, giai điệu dễ nhớ và độ vang âm trong suốt dự án.',
  },
  {
    icon: 'bi-sliders',
    title: 'Sản xuất',
    description: 'Kiểm tra thiết kế âm thanh, kỹ thuật không gian, phân tách tần số, độ ấm âm thanh, dải động và cân bằng trộn kỹ thuật.',
  },
  {
    icon: 'bi-file-earmark-text',
    title: 'Ca từ',
    description: 'Đánh giá khả năng kể chuyện, cách diễn đạt thơ ca, sự dễ tổn thương trong chủ đề, hình ảnh ẩn dụ và giá trị văn học.',
  },
  {
    icon: 'bi-layers-half',
    title: 'Cấu trúc và chủ đề',
    description: 'Đánh giá cấu trúc album, nhịp độ, sự chuyển tiếp giữa các bài hát, và sự thống nhất về chủ đề hoặc âm thanh.',
  },
  {
    icon: 'bi-lightbulb',
    title: 'Độc đáo',
    description: 'Đánh giá sự đổi mới về âm thanh, khả năng vượt qua các giới hạn thể loại, lòng dũng cảm nghệ thuật và dấu ấn sáng tạo riêng biệt so với các xu hướng thông thường.',
  },
  {
    icon: 'bi-globe',
    title: 'Ảnh hưởng',
    description: 'Phản ánh dấu ấn lịch sử, ảnh hưởng đối với các nghệ sĩ đương đại, vai trò lãnh đạo trong các phong trào âm nhạc, tính vượt thời gian và sự lan tỏa văn hóa.',
  },
];

const ratingTiers = [
  {
    score: '9.0 – 10.0',
    label: 'Tuyệt tác / Kinh điển',
    isHigh: true,
    description: 'Một kiệt tác có sức ảnh hưởng, định hình lại các giới hạn thể loại và đáng nghe đi nghe lại nhiều lần.',
  },
  {
    score: '8.0 – 8.9',
    label: 'Xuất sắc / Rất đáng nghe',
    isHigh: true,
    description: 'Tuyệt vời, có tầm nhìn, việc triển khai mỗi bài hát nhất quán, gần như là tuyệt vời.',
  },
  {
    score: '7.0 – 7.9',
    label: 'Tốt / Rất đáng nghe',
    isHigh: false,
    description: 'Một album chỉn chu với những điểm nhấn ấn tượng, nhưng có thể thiếu tính nhất quán.',
  },
  {
    score: '5.0 – 6.9',
    label: 'Trung bình / Khá',
    isHigh: false,
    description: 'Một vài bài hát hứa hẹn hoặc sản xuất tốt nhưng bị lấp đầy bởi các bài hát filler hoặc ý tưởng không tập trung.',
  },
  {
    score: 'Dưới 5.0',
    label: 'Thiếu Sáng Tạo',
    isHigh: false,
    description: 'Thiếu sự trau chuốt về mặt kỹ thuật, tham vọng sáng tạo hoặc sự gắn kết về cảm xúc.',
  },
];
---

<BaseLayout 
  title="Giới thiệu SoundsGood"
  description="Tìm hiểu về phong cách review của SoundsGood, 6 khía cạnh đánh giá, và cách tính điểm SoundsGood"
>
  <div class="about-container">
    <!-- Hero Banner -->
    <header class="about-hero">
      <h1 class="page-title">Đây là gì?</h1>
      <p class="about-subtitle">
        Một nền tảng tối giản, tập trung vào nội dung, dành riêng cho phê bình album âm nhạc với phân tích đa chiều.
      </p>
    </header>

    <hr class="section-divider" />

    <!-- Mission & Why -->
    <section class="about-section">
      <h2 class="section-heading">Tại sao SoundsGood ra đời?</h2>
      <div class="prose-block">
        <p>
          Trong một thời đại mà âm nhạc bị chi phối bởi những đoạn cắt ngắn 15 giây trên mạng xã hội, danh sách phát theo thuật toán và sự phẫn nộ của giới truyền thông, 
          nghệ thuật thưởng thức trọn vẹn một album nhạc thường bị lu mờ.
        </p>
        <p>
          <strong>SoundsGood</strong> được tạo ra để cung cấp một không gian nghe nhạc tối giản và không bị phân tâm cho những người yêu thích phê bình album một cách nghiêm túc. 
          Không có quảng cáo pop-up, không có nguồn cấp dữ liệu vô tận và không có trình theo dõi rườm rà—chỉ có các trang tĩnh siêu tốc, nội dung sâu sắc và tiêu chí đánh giá minh bạch.
        </p>
      </div>
    </section>

    <!-- Spectrum Model Explanation -->
    <section class="about-section">
      <h2 class="section-heading">Mô hình Đánh giá 6 Khía cạnh</h2>
      <p class="section-lead">
        Thay vì chỉ dựa vào một con số duy nhất, SoundsGood sử dụng mô hình radar 6 khía cạnh để phân tích đa chiều mọi khía cạnh của âm nhạc.
      </p>

      <div class="spectrum-grid">
        {spectrumAxes.map((axis) => (
          <div class="spectrum-card">
            <div class="card-icon-box">
              <i class={`bi ${axis.icon} axis-icon`}></i>
            </div>
            <div class="card-info">
              <h3 class="axis-title">{axis.title}</h3>
              <p class="axis-desc">{axis.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Overall Rating Breakdown -->
    <section class="about-section">
      <h2 class="section-heading">Hiểu về Điểm số SoundsGood</h2>
      <p class="section-lead">
        Điểm số SoundsGood dao động từ <strong>0.0 đến 10.0</strong>. Điểm số được đánh giá dựa trên tổng thể của mô hình 6 khía cạnh.
      </p>

      <div class="rating-tiers-list">
        {ratingTiers.map((tier) => (
          <div class="tier-item">
            <div class="tier-score-badge">
              <span class={`tier-val ${tier.isHigh ? 'tier-high' : ''}`}>{tier.score}</span>
              {tier.isHigh && <i class="bi bi-hand-thumbs-up thumbs-icon"></i>}
            </div>
            <div class="tier-info">
              <h3 class="tier-label">{tier.label}</h3>
              <p class="tier-desc">{tier.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about-container {
    max-width: 860px;
    margin: 0 auto;
  }

  .about-hero {
    padding-bottom: 1.5rem;
  }

  .page-title {
    font-family: 'Noto Sans', sans-serif;
    font-size: 2rem;
    font-weight: 800;
    font-style: italic;
    letter-spacing: -0.03em;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  @media (min-width: 640px) {
    .page-title {
      font-size: 2.5rem;
    }
  }

  .about-subtitle {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 0;
  }

  .section-divider {
    border-top: 1px solid var(--border-color);
    margin: 2rem 0 2.5rem 0;
  }

  .about-section {
    margin-bottom: 3rem;
  }

  .section-heading {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--text-primary);
    border-left: 3px solid var(--border-light);
    padding-left: 0.75rem;
  }

  .section-lead {
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .prose-block p {
    line-height: 1.75;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .prose-block strong {
    color: var(--text-primary);
  }

  /* 6-Axis Grid */
  .spectrum-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .spectrum-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .spectrum-card {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.25rem;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 8px;
  }

  .card-icon-box {
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    color: var(--text-primary);
  }

  .axis-icon {
    font-size: 1.25rem;
  }

  .card-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .axis-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .axis-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 0;
  }

  /* Rating Tiers List */
  .rating-tiers-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .tier-item {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    padding: 1.25rem;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    align-items: center;
  }

  @media (min-width: 640px) {
    .tier-item {
      grid-template-columns: 180px 1fr;
    }
  }

  .tier-score-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .tier-val {
    font-size: 1.1rem;
    font-weight: 800;
    font-family: var(--font-sans);
    color: var(--text-primary);
  }

  .tier-high {
    color: var(--color-accent-high) !important;
  }

  .thumbs-icon {
    color: var(--color-accent-high);
    font-size: 1.1rem;
  }

  .tier-label {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.2rem;
  }

  .tier-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: 0;
    line-height: 1.5;
  }
</style>
