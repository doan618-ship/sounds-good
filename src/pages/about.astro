---
import BaseLayout from '../layouts/BaseLayout.astro';

const spectrumAxes = [
  {
    icon: 'bi-music-note-beamed',
    title: 'Giai điệu',
    description: 'Đánh giá tính bắt tai, dễ nhớ, vòng hòa âm và sự thể hiện cảm xúc cốt lõi.',
  },
  {
    icon: 'bi-sliders',
    title: 'Sản xuất',
    description: 'Đánh giá chất lượng thu âm, mix and master, sắp xếp nhạc cụ, các thiết kế và chất liệu âm thanh đặc trưng.',
  },
  {
    icon: 'bi-file-earmark-text',
    title: 'Ca từ',
    description: 'Đánh giá khả năng kể chuyện và sử dụng hình ảnh, thông điệp, các kỹ thuật thơ ca, gieo vần, nhịp điệu.',
  },
  {
    icon: 'bi-layers-half',
    title: 'Cấu trúc và chủ đề',
    description: 'Đánh giá cấu trúc album, nhịp độ, sự chuyển tiếp giữa các bài hát, mạch cảm xúc và sự thống nhất về chủ đề xuyên suốt.',
  },
  {
    icon: 'bi-lightbulb',
    title: 'Độc đáo',
    description: 'Đánh giá bản sắc nghệ sĩ, sự đổi mới, tham vọng nghệ thuật, khả năng thoát ra khỏi những công thức sẵn có hoặc/và sản phẩm trước đây của nghệ sĩ, và sự dũng cảm trong việc theo đuổi các thể nghiệm.',
  },
  {
    icon: 'bi-globe',
    title: 'Ảnh hưởng',
    description: 'Đánh giá sự bền vững theo thời gian, tầm ảnh hưởng đối với sự nghiệp của nghệ sĩ, vai trò dẫn dắt xu hướng nghệ thuật/văn hóa và di sản để lại cho thế hệ/thời kỳ sau này.',
  },
];

const ratingTiers = [
  {
    score: '9.0 – 10.0',
    label: 'Tuyệt tác / Kinh điển',
    isHigh: true,
    description: 'Một kiệt tác có sức ảnh hưởng, định hình lại các giới hạn và đáng nghe đi nghe lại nhiều lần.',
  },
  {
    score: '8.0 – 8.9',
    label: 'Xuất sắc / Rất đáng nghe',
    isHigh: true,
    description: 'Tuyệt vời, có ý tưởng rõ ràng và việc triển khai mỗi bài hát nhất quán.',
  },
  {
    score: '7.0 – 7.9',
    label: 'Tốt / Đáng nghe',
    isHigh: false,
    description: 'Một album chỉn chu với những điểm nhấn ấn tượng, nhưng có thể thiếu tính nhất quán.',
  },
  {
    score: '5.0 – 6.9',
    label: 'Trung bình / Khá',
    isHigh: false,
    description: 'Một vài bài hát có tiềm năng hoặc sản xuất tốt nhưng bị lấp đầy bởi các bài hát filler hoặc ý tưởng không rõ ràng.',
  },
  {
    score: 'Dưới 5.0',
    label: 'Hạn chế',
    isHigh: false,
    description: 'Thiếu sự trau chuốt về mặt kỹ thuật, tham vọng sáng tạo hoặc sự gắn kết về cảm xúc.',
  },
];
---

<BaseLayout 
  title="Giới thiệu SoundsGood"
  description="Tìm hiểu về phong cách review của SoundsGood, 6 khía cạnh đánh giá, và cách tính điểm SoundsGood"
>
  <div class="about-container">
    <!-- Hero Banner -->
    <header class="about-hero">
      <h1 class="page-title">Đây là gì?</h1>
      <p class="about-subtitle">
        Một nền tảng review album tập trung vào nội dung, nơi lưu trữ những album có ảnh hưởng.
      </p>
    </header>

    <hr class="section-divider" />

    <!-- Mission & Why -->
    <section class="about-section">
      <h2 class="section-heading">Tại sao SoundsGood ra đời?</h2>
      <div class="prose-block">
        <p>
          Trong thời đại âm nhạc bị chi phối bởi những đoạn shorts 15 giây trên mạng xã hội, playlist theo thuật toán và sự phẫn nộ hoặc phóng đại của truyền thông, 
          nghệ thuật thưởng thức trọn vẹn album nhạc đang dần bị lu mờ.
        </p>
        <p>
          SoundsGood được tạo ra để lưu trữ những album có ảnh hưởng và tạo một không gian không bị phân tâm cho những người yêu thích phê bình album một cách nghiêm túc. 
          Không có quảng cáo pop-up, không có news feed và không có trackers.
        </p>
      </div>
    </section>

    <!-- Spectrum Model Explanation -->
    <section class="about-section">
      <h2 class="section-heading">Mô hình Đánh giá</h2>
      <p class="section-lead">
        Thay vì chỉ dựa vào một con số duy nhất, SoundsGood sử dụng mô hình radar 6 khía cạnh để phân tích cân bằng về kỹ thuật, nghệ thuật và bối cảnh của các album.
      </p>

      <div class="spectrum-grid">
        {spectrumAxes.map((axis) => (
          <div class="spectrum-card">
            <div class="card-icon-box">
              <i class={`bi ${axis.icon} axis-icon`}></i>
            </div>
            <div class="card-info">
              <h3 class="axis-title">{axis.title}</h3>
              <p class="axis-desc">{axis.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Overall Rating Breakdown -->
    <section class="about-section">
      <h2 class="section-heading">Điểm SoundsGood</h2>
      <p class="section-lead">
        Điểm SoundsGood dao động từ <strong>0.0 đến 10.0</strong>. Điểm số được đánh giá dựa trên trung bình mô hình 6 khía cạnh.
      </p>

      <div class="rating-tiers-list">
        {ratingTiers.map((tier) => (
          <div class="tier-item">
            <div class="tier-score-badge">
              <span class={`tier-val ${tier.isHigh ? 'tier-high' : ''}`}>{tier.score}</span>
              {tier.isHigh && <i class="bi bi-hand-thumbs-up thumbs-icon"></i>}
            </div>
            <div class="tier-info">
              <h3 class="tier-label">{tier.label}</h3>
              <p class="tier-desc">{tier.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about-container {
    max-width: 860px;
    margin: 0 auto;
  }

  .about-hero {
    padding-bottom: 1.5rem;
  }

  .page-title {
    font-family: 'Noto Sans', sans-serif;
    font-size: 2rem;
    font-weight: 800;
    font-style: italic;
    letter-spacing: -0.03em;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  @media (min-width: 640px) {
    .page-title {
      font-size: 2.5rem;
    }
  }

  .about-subtitle {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 0;
  }

  .section-divider {
    border-top: 1px solid var(--border-color);
    margin: 2rem 0 2.5rem 0;
  }

  .about-section {
    margin-bottom: 3rem;
  }

  .section-heading {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--text-primary);
    border-left: 3px solid var(--border-light);
    padding-left: 0.75rem;
  }

  .section-lead {
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .prose-block p {
    line-height: 1.75;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .prose-block strong {
    color: var(--text-primary);
  }

  /* 6-Axis Grid */
  .spectrum-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .spectrum-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .spectrum-card {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.25rem;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 8px;
  }

  .card-icon-box {
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    color: var(--text-primary);
  }

  .axis-icon {
    font-size: 1.25rem;
  }

  .card-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .axis-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .axis-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 0;
  }

  /* Rating Tiers List */
  .rating-tiers-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .tier-item {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    padding: 1.25rem;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    align-items: center;
  }

  @media (min-width: 640px) {
    .tier-item {
      grid-template-columns: 180px 1fr;
    }
  }

  .tier-score-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .tier-val {
    font-size: 1.1rem;
    font-weight: 800;
    font-family: var(--font-sans);
    color: var(--text-primary);
  }

  .tier-high {
    color: var(--color-accent-high) !important;
  }

  .thumbs-icon {
    color: var(--color-accent-high);
    font-size: 1.1rem;
  }

  .tier-label {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.2rem;
  }

  .tier-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: 0;
    line-height: 1.5;
  }
</style>
