---
import type { CollectionEntry } from 'astro:content';

interface Props {
  review: CollectionEntry<'reviews'>;
}

const { review } = Astro.props;
const { data, id } = review;
const isHigh = data.rating >= 8.0;

const formattedDate = new Date(data.pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="review-card">
  <a href={`/reviews/${id}`} class="card-link" aria-label={`Read review of ${data.title} by ${data.artist}`}>
    <!-- 1/2 Left on Mobile -->
    <div class="cover-wrapper">
      <img 
        src={data.coverImage} 
        alt={`${data.title} by ${data.artist} album cover`} 
        loading="lazy" 
        width="300"
        height="300"
        class="cover-image" 
      />
    </div>

    <!-- 1/2 Right on Mobile -->
    <div class="card-rating-side">
      <span class={`rating-score ${isHigh ? 'score-high' : ''}`}>
        {data.rating.toFixed(1)}
      </span>
      {isHigh && (
        <div class="thumbs-up-wrapper">
          <i class="bi bi-hand-thumbs-up score-thumbs-up"></i>
        </div>
      )}
    </div>
    
    <!-- Rest of Content Below Top Row on Mobile -->
    <div class="card-content">
      <div class="card-meta">
        <span class="artist-name">{data.artist}</span>
        <span class="meta-separator">&bull;</span>
        <time datetime={data.pubDate.toISOString()} class="pub-date">{formattedDate}</time>
      </div>

      <h2 class="album-title">{data.title} <span class="release-year">({data.releaseYear})</span></h2>

      <p class="summary">{data.summary}</p>

      <div class="tag-list">
        {data.tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    </div>
  </a>
</article>

<style>
  .review-card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    overflow: hidden;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }

  .review-card:hover {
    border-color: var(--border-light);
    background-color: var(--bg-card-hover);
  }

  /* Mobile Grid: Row 1 = 1/2 cover, 1/2 rating. Row 2 = Rest of content */
  .card-link {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    padding: 1.25rem;
    align-items: stretch;
  }

  .cover-wrapper {
    grid-column: 1 / 2;
    grid-row: 1;
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: 4px;
    overflow: hidden;
    background-color: var(--bg-secondary);
    width: 100%;
  }

  .cover-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-rating-side {
    grid-column: 2 / 3;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 0.75rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 6px;
  }

  .card-content {
    grid-column: 1 / -1;
    grid-row: 2;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  /* Desktop Grid: 160px cover | 1fr content | auto rating */
  @media (min-width: 640px) {
    .card-link {
      grid-template-columns: 160px 1fr auto;
      align-items: center;
    }

    .cover-wrapper {
      grid-column: 1;
      grid-row: 1;
      width: 160px;
    }

    .card-content {
      grid-column: 2;
      grid-row: 1;
    }

    .card-rating-side {
      grid-column: 3;
      grid-row: 1;
      width: auto;
      height: auto;
      background: transparent;
      border: none;
      padding: 0 0 0 0.5rem;
      min-width: 80px;
    }
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .artist-name {
    color: var(--text-secondary);
    font-weight: 600;
  }

  .album-title {
    font-family: 'Noto Sans', sans-serif;
    font-size: 1.35rem;
    font-weight: 800;
    font-style: italic;
    color: var(--text-primary);
    line-height: 1.2;
  }

  .release-year {
    font-style: normal;
    font-weight: 500;
    color: var(--text-muted);
    font-size: 1.1rem;
  }

  .summary {
    font-size: 0.925rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 0.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .rating-score {
    font-family: var(--font-sans);
    font-size: 2.65rem;
    font-weight: 800;
    line-height: 1;
    color: var(--text-primary);
  }

  .score-high {
    color: var(--color-accent-high) !important;
    font-weight: 800 !important;
  }

  .thumbs-up-wrapper {
    margin-top: 0.25rem;
    display: flex;
    justify-content: center;
  }

  .score-thumbs-up {
    color: var(--color-accent-high);
    font-size: 1.35rem;
  }
</style>
