---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-content">
    <p class="footer-meta">&copy; {year} Một dự án của <span class="accent-link"><a href="https://www.linkedin.com/in/doan-vo-dinh/">Doan Vo</a></span></p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--border-color);
    padding: 2.5rem 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .accent-link {
    font-weight: 500;
    color: var(--text-secondary);
    transition: color 0.15s ease;
  }
  .accent-link:hover {
    color: var(--text-primary);
  }
</style>
