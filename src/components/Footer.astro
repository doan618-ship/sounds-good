---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-content">
    <p class="footer-meta">&copy; {year} by <a href="https://www.linkedin.com/in/doan-vo-dinh/">Doan Vo</a></p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--border-color);
    padding: 2.5rem 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .footer-meta {
    margin-bottom: 0;
    font-family: var(--font-sans);
    font-size: 0.85rem;
  }
</style>
